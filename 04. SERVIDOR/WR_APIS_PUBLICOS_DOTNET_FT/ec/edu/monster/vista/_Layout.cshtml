@{
    var titulo = ViewData["Titulo"] as string ?? "";
    var icono = ViewData["Icono"] as string ?? "squares-four";
    var activa = ViewData["Activa"] as string;
    var ancho = ViewData["Ancho"] as string ?? "form";
    
    var mensaje = TempData["mensaje"] as string;
    var tipo = TempData["tipo"] as string;

    string Clase(string nombre) => activa == nombre ? " activa" : "";
    string? Actual(string nombre) => activa == nombre ? "page" : null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@titulo · APIs públicas .NET</title>
    <link rel="stylesheet" href="https://unpkg.com/@@phosphor-icons/web@2.1.1/src/regular/style.css">
    <link rel="stylesheet" href="https://unpkg.com/@@phosphor-icons/web@2.1.1/src/duotone/style.css">
    <link rel="stylesheet" href="~/css/estilos.css" asp-append-version="true">
</head>
<body>
<header class="barra-app">
    <div class="marca"><span class="insignia"><i class="ph-duotone ph-globe-hemisphere-west"></i></span>APIs públicas .NET SQL Server</div>
    <nav aria-label="Principal">
        <a class="nav-btn@(Clase("paises"))" href="@Url.Content("~/paises")" aria-current="@Actual("paises")"><i class="ph ph-house"></i><span>Inicio</span></a>
        <a class="nav-btn@(Clase("buscar"))" href="@Url.Content("~/paises/buscar-api")" aria-current="@Actual("buscar")"><i class="ph ph-cloud-arrow-down"></i><span>Buscar en la API</span></a>
        <a class="nav-btn@(Clase("reportes"))" href="@Url.Content("~/reportes")" aria-current="@Actual("reportes")"><i class="ph ph-chart-bar"></i><span>Reportes</span></a>
    </nav>
</header>

<main class="pagina pagina--@ancho">
    <section class="hoja">
        <div class="cinta">
            <span class="insignia"><i class="ph-duotone ph-@icono"></i></span>
            <h1>@titulo</h1>
        </div>
        @RenderBody()
        @if (!string.IsNullOrEmpty(mensaje))
        {
            <div class="estado" data-estado><ui-mensaje tipo="@tipo" mensaje="@mensaje" /></div>
        }
    </section>
</main>

<footer class="pie">
    <span>Arquitectura de Software - 36883</span>
    <span>Frederick Tipán</span>
</footer>
<script src="~/js/app.js" asp-append-version="true"></script>
</body>
</html>
