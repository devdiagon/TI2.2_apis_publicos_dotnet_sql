@using System.Globalization
@model ReportesVista
@{
    ViewData["Titulo"] = "Reportes";
    ViewData["Icono"] = "chart-bar";
    ViewData["Activa"] = "reportes";
    ViewData["Ancho"] = "reportes";
    
    string Porcentaje(double valor) => valor.ToString("0.##", CultureInfo.InvariantCulture);
}

@if (Model.Conteo.Count == 0)
{
    <ui-mensaje tipo="info" mensaje="Aún no hay países; importe primero desde Inicio" />
}
else
{
    <div class="reporte-fila">
        <div class="tabla-wrap" style="max-height:none">
            <table>
                <thead><tr><th>Región</th><th class="num">Países</th><th style="width:40%"></th></tr></thead>
                <tbody>
                    @foreach (var fila in Model.Conteo)
                    {
                        <tr>
                            <td>@fila.Region</td>
                            <td class="num">@fila.Total.ToString("N0")</td>
                            <td><div class="pista"><div class="barra-rel" style="width:@(Porcentaje(fila.Porcentaje))%"></div></div></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="globo-tarjeta capa">
            <img src="~/img/globo.gif" alt="Globo terráqueo girando">
        </div>
    </div>

    <div class="datos">
        <div class="dato capa">
            <span class="insignia"><i class="ph-duotone ph-map-trifold"></i></span>
            <div><small>Región con más países</small><b>@Model.RegionTop · @Model.RegionTopTotal.ToString("N0")</b></div>
        </div>
        <div class="dato capa">
            <span class="insignia"><i class="ph-duotone ph-users-three"></i></span>
            <div>
                <small>País más poblado</small>
                <b>@Model.MasPoblado?.Nombre · @Model.MasPoblado?.Poblacion.ToString("N0") hab.</b>
            </div>
        </div>
    </div>

    <h2 class="subtitulo">Promedio poblacional por región</h2>
    <div class="tabla-wrap" style="max-height:none">
        <table>
            <thead><tr><th>Región</th><th class="num">Promedio de habitantes</th><th style="width:40%"></th></tr></thead>
            <tbody>
                @foreach (var fila in Model.Promedios)
                {
                    <tr>
                        <td>@fila.Region</td>
                        <td class="num">@fila.Promedio.ToString("N0")</td>
                        <td><div class="pista"><div class="barra-rel" style="width:@(Porcentaje(fila.Porcentaje))%"></div></div></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
